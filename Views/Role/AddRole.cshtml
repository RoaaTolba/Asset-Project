@model RoleViewModel
@{
    ViewData["Title"] = "AddRole";
}

<div class="container-fluid">
    <!-- Zero configuration table -->
    <form asp-action="AddRole" asp-controller="Role" method="post" class="form form-horizontal">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title-wrap bar-success">
                            <h4 class="card-title">Add New Group </h4>
                        </div>
                    </div>
                    <div class="card-body collapse show">
                        <div class="col-md-9">
                        <div class="row container m-auto d-flex justify-content-center">
                            <!-- <div class="col-lg-2"></div>
                                <div class="col-sm-12 col-md-9">
                                <div id="DataTables_Table_0_filter" class="dataTables_filter"><label>Group Name :<input type="search" 
                                    class="form-control form-control-sm" placeholder="" aria-controls="DataTables_Table_0" style="height: 58px;"></label></div>
                            </div> -->
                            <label>Group Name :</label>
                            <input asp-for="RoleName" type="text" class="form-control form-control-sm w-50" placeholder="" aria-controls="DataTables_Table_0">
                            <div class="col-lg-3">
                                 @* <button id="addRow" class="btn btn-success mb-2">
                                     <a href="#">Add Group</a>
                                 </button> *@
                                <button type="submit" class="btn btn-success mb-2">
                                    Add Group
                                </button>
                            </div>

                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>
                    </div>
                    <table class="table table-striped table-bordered zero-configuration mt-40 table-group">
                        <thead>
                            <tr>
                                <th>Module Name</th>
                                <th>Show </th>
                                <th>Add</th>
                                <th>Edit</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                            <tbody>
                                <tr>
                                    <td>Employees</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[0].IsSelected"> <input type="hidden" asp-for="@Model.RoleClaims[0].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[1].IsSelected"> <input type="hidden" asp-for="@Model.RoleClaims[1].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[2].IsSelected"> <input type="hidden" asp-for="@Model.RoleClaims[2].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[3].IsSelected"> <input type="hidden" asp-for="@Model.RoleClaims[3].DisplayVlue"></td>
                                </tr>
                                <tr>
                                    <td>Attendance</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[4].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[4].DisplayVlue"></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                </tr>
                                <tr>
                                    <td>Salary report</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[5].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[5].DisplayVlue"></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                </tr>
                                <tr>
                                    <td>Genral Settings</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[6].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[6].DisplayVlue"></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                    <td> <input type="checkbox" disabled></td>
                                </tr>
                                <tr>
                                    <td>Users</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[7].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[7].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[8].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[8].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[9].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[9].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[10].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[10].DisplayVlue"></td>
                                </tr>
                                <tr>
                                    <td>Groups</td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[11].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[11].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[12].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[12].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[13].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[13].DisplayVlue"></td>
                                    <td> <input type="checkbox" asp-for="@Model.RoleClaims[14].IsSelected"><input type="hidden" asp-for="@Model.RoleClaims[14].DisplayVlue"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
            </div>
        </div>    
    </form>
</div>
                
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}