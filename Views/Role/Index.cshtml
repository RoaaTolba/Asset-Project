@inject IAuthorizationService AuthorizationService
@using AssetsPro.Constants
@using Microsoft.AspNetCore.Identity
@Model IdentityRole
@{
    ViewData["Title"] = "Index";
    var roles = ViewBag.roles as List<IdentityRole>;
}

<div class="container-fluid">
    <!-- Zero configuration table -->
    <section id="configuration">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title-wrap bar-success">
                            <h4 class="card-title">Groups</h4>
                        </div>
                    </div>
                    <div class="card-body collapse show">
                        <div class="card-block card-dashboard">
                            @* <p class="card-text">DataTables has most features enabled by default, so all you need to do to use it with your own ables is to call the construction</p> *@
                            @* <div class="row">
                                <div class="col-sm-12 col-md-3">
                                    <div class="dataTables_length" id="DataTables_Table_0_length"><label>Show 
                                        <select name="DataTables_Table_0_length" aria-controls="DataTables_Table_0" class="form-control form-control-sm">
                                            <option value="10">10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                        </select> </label></div>
                                </div>
                                <div class="col-lg-1"></div>
                                <div class="col-sm-12 col-md-3">
                                    <div id="DataTables_Table_0_filter" class="dataTables_filter"><label>Search:<input type="search" 
                                     class="form-control form-control-sm" placeholder="" aria-controls="DataTables_Table_0"></label></div>
                                </div>
                                <div class="col-lg-1"></div>
                                 
                            </div> *@
                            <table class="table table-striped table-bordered zero-configuration" style="text-align: center;">
                                <thead>
                                    <tr>
                                        <th class="text-center">Id</th>
                                        <th class="text-center">Name</th>
                                        @if (AuthorizationService.AuthorizeAsync(User, Permessions.Groups.Edit).Result.Succeeded)
                                        {
                                            <th class="text-center">Edit </th>
                                        }
                                        @* <th class="text-center">Delete</th> *@
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (roles != null)
                                    {
                                        @for (int i = roles.Count-1, j=0; i >=0 ;j++, i--)
                                       {
                                        var item = roles[i];
                                        <tr asp-for="@item.Id" data-id="@item.Id" class="clickable-row" selectable-row>
                                            <td>@(j + 1)</td> <!-- Counter starts from 1 -->
                                            <td>@item.Name</td>
                                            @if (AuthorizationService.AuthorizeAsync(User, Permessions.Groups.Edit).Result.Succeeded)
                                            {
                                                <td >
                                                    <a asp-controller="Role" asp-action="Edit" asp-route-roleId="@item.Id" class="btn btn-success mr-1">
                                                        <i class="icon-note"></i> Edit
                                                    </a>
                                                </td>
                                            }
                                            @* <td>
                                                <button type="button" class="btn btn-danger mr-1" asp-controller="Role" asp-action="Delete">
                                                    <i class="icon-trash"></i> Delete
                                                </button>
                                            </td> *@
                                        </tr>
                                       }
                                    }
                                     @* <tr class="user">
                                         <td class="text-center">1</td>
                                         <td class="text-center">Admin </td>
                                         <td class="text-center"><button class="btn btn-success mb-2"> 
                                             <a href="#">edit</a></button></td>
                                         <td class="text-center"><button class="btn btn-danger mb-2"> 
                                             <a href="#">delete</a></button></td>
                                     </tr> *@
                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>
